# ── Database ───────────────────────────────────────────────
# Local development uses a SQLite file (created automatically).
DATABASE_URL="file:./data/explorebound.db"
# For production on serverless hosts (Vercel etc.) use Turso / libSQL:
# DATABASE_URL="libsql://your-db-name.turso.io"
# DATABASE_AUTH_TOKEN="your-turso-token"

# ── Admin panel (/admin) ──────────────────────────────────
ADMIN_EMAIL="admin@explorebound.com"
ADMIN_PASSWORD="change-me-please"
# Long random string used to sign admin sessions: `openssl rand -hex 32`
AUTH_SECRET="replace-with-a-long-random-string"

# ── Public site URL (used for SEO, sitemap, share links) ───
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
